# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Matches [tool.ruff] line-length in pyproject.toml
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{svg,lock}]
insert_final_newline = false
trim_trailing_whitespace = false
